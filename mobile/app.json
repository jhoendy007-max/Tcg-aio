{
  "expo": {
    "name": "Zzz APP",
    "slug": "tcgaio",
    "version": "0.2.35",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "tcgaio",
    "ios": {
      "bundleIdentifier": "com.tcgaio.phone",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Zzz APP scans the pairing QR code shown on your PC.",
        "NSLocalNetworkUsageDescription": "Zzz APP connects to the desktop app on your Wi-Fi.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tcgaio.phone",
      "versionCode": 235,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#14161b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Zzz APP scans the pairing QR code shown on your PC."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8b5cf6",
          "icon": "./assets/android-icon-monochrome.png"
        }
      ],
      "./plugins/withWidgets"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050e2b"
    }
  }
}
