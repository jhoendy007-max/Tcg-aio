{
  "manifest_version": 3,
  "name": "Zzz AIO Session Sync",
  "version": "0.2.35",
  "description": "Sends your own store sign-in from this browser to Zzz AIO on your PC. It does not read other sites.",
  "permissions": ["cookies", "storage", "alarms", "scripting"],
  "host_permissions": [
    "https://www.target.com/*",
    "https://*.target.com/*",
    "https://www.walmart.com/*",
    "https://*.walmart.com/*",
    "https://www.bestbuy.com/*",
    "https://*.bestbuy.com/*",
    "https://www.pokemoncenter.com/*",
    "https://*.pokemoncenter.com/*",
    "https://www.amazon.com/*",
    "https://*.amazon.com/*",
    "https://www.crunchyroll.com/*",
    "https://store.crunchyroll.com/*",
    "https://*.crunchyroll.com/*",
    "https://p-bandai.com/*",
    "https://www.p-bandai.com/*",
    "https://*.p-bandai.com/*",
    "https://www.gamestop.com/*",
    "https://*.gamestop.com/*",
    "https://www.barnesandnoble.com/*",
    "https://*.barnesandnoble.com/*",
    "https://www.costco.com/*",
    "https://*.costco.com/*",
    "https://www.samsclub.com/*",
    "https://*.samsclub.com/*",
    "https://www.tcgplayer.com/*",
    "https://*.tcgplayer.com/*"
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zzz AIO Session Sync",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
