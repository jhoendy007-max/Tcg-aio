{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/engine/**/*",
    "src/shared/**/*",
    "src/stores/**/*",
    "src/phone/**/*",
    "tests/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "license-server/**/*"
  ],
  "exclude": [
    "src/stores/target/bypass.ts",
    "tests/fixtures/**/*.tsx"
  ]
}
