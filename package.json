{
  "name": "tcgaio",
  "version": "0.2.10",
  "private": true,
  "description": "Windows desktop checkout assistant for Pokémon TCG and One Piece TCG drops.",
  "main": "./out/main/index.js",
  "author": "TCGAIO",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win nsis --publish never",
    "phone:relay": "tsx src/phone/relay-cli.ts",
    "bench:monitors": "tsx src/engine/bench-cli.ts",
    "pack:extension": "node scripts/pack-extension.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "undici": "^6.21.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.tcgaio.desktop",
    "productName": "TCGAIO",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "out/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TCGAIO"
    },
    "publish": {
      "provider": "github",
      "owner": "jhoendy007-max",
      "repo": "Tcg-aio",
      "private": true,
      "releaseType": "prerelease"
    }
  }
}
